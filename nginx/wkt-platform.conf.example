# Replace YOUR_DOMAIN.example and both certificate paths before installation.
# This file belongs in the host Nginx http context (for example sites-available).

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name YOUR_DOMAIN.example;

    ssl_certificate /REPLACE/WITH/fullchain.pem;
    ssl_certificate_key /REPLACE/WITH/privkey.pem;

    # ESP32 camera JPEGs and AI WAV requests can be a few MiB.
    client_max_body_size 16m;

    location = /intercom/ws {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # No URI suffix on proxy_pass: preserve /ai/... and the query string.
    location /ai/ {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_request_buffering on;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Preserve /camera/... exactly; allow slower JPEG uploads and vision calls.
    location /camera/ {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_request_buffering on;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Keep the verified OTA URI/query, Range and If-Range end to end.
    location /api/v1/ota/ {
        proxy_pass http://127.0.0.1:18082;
        proxy_http_version 1.1;
        proxy_read_timeout 10m;
        proxy_send_timeout 10m;
        proxy_buffering off;
        proxy_force_ranges on;
        gzip off;
        proxy_set_header Accept-Encoding "";
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;

        # Query-token compatibility is disabled by default. Avoid leaking a
        # token into the standard request log if it is ever explicitly enabled.
        access_log off;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

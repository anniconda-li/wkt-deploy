# Copy this file to .env. Keep .env untracked and replace secret placeholders.
INTERCOM_IMAGE=ghcr.io/anniconda-li/wkt-intercom-server:0.1.0
AI_IMAGE=ghcr.io/anniconda-li/wkt-ai-server:0.3.0
OTA_IMAGE=ghcr.io/anniconda-li/wkt-ota-server:1.0.0

# Public host ports used directly by first-stage devices.
INTERCOM_HOST_PORT=18081
AI_HOST_PORT=18080
OTA_HOST_PORT=18082

# Persistent host roots. Relative paths are resolved from this repository.
AI_DATA_ROOT=./data/ai
OTA_DATA_ROOT=./data/ota
BACKUP_ROOT=./backups

# OTA runtime. First-stage laboratory validation uses public HTTP without a token.
OTA_PUBLIC_BASE_URL=http://139.129.17.67:18082
OTA_LOG_LEVEL=INFO

# Intercom runtime (confirmed from ../wkt-intercom-server).
INTERCOM_LOG_STATS=1
INTERCOM_LOG_AUDIO_TRACE=0
INTERCOM_AUDIO_LOG_EVERY_N=50
INTERCOM_SEND_QUEUE_MAX=80
INTERCOM_SEND_TIMEOUT_SECONDS=2
INTERCOM_REALTIME_WINDOW_MS=400
INTERCOM_STATS_INTERVAL_MS=1000

# AI runtime (confirmed from ../wkt-ai-server). Never commit real keys.
OPENAI_API_KEY=REPLACE_WITH_SECRET
OPENAI_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com
LOG_LEVEL=INFO
DASHSCOPE_API_KEY=REPLACE_WITH_SECRET
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_PROVIDER=dashscope
VISION_MODEL=qwen3.6-flash-2026-04-16
VISION_ENABLE_THINKING=false
# Optional overrides; leave commented to reuse the shared DashScope settings.
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_API_KEY=REPLACE_WITH_SECRET
VISION_MIN_CONFIDENCE=0.60
VISION_TIMEOUT_SECONDS=120
MAX_SAVED_IMAGES_PER_DEVICE=10
CAMERA_UPLOAD_IDLE_TIMEOUT_SECONDS=8
CAMERA_IDEMPOTENCY_DB_PATH=/app/uploads/camera_idempotency.sqlite3
CAMERA_IDEMPOTENCY_TTL_SECONDS=1200
CAMERA_IDEMPOTENCY_MAX_RECORDS=1000
CAMERA_IDEMPOTENCY_WAIT_TIMEOUT_SECONDS=180
CAMERA_IDEMPOTENCY_POLL_INTERVAL_SECONDS=0.1
CAMERA_CHUNK_TEMP_DIR=/app/uploads/camera_chunks
CAMERA_CHUNK_SESSION_TTL_SECONDS=600
CAMERA_CHUNK_COMPLETED_TTL_SECONDS=1200
CAMERA_CHUNK_MAX_SESSIONS=100
CAMERA_CHUNK_MAX_TEMP_BYTES=67108864
CAMERA_CHUNK_CLEANUP_INTERVAL_SECONDS=60
AI_WS_DB_PATH=/app/uploads/ai_ws.sqlite3
AI_WS_TEMP_DIR=/app/uploads/ai_ws
AI_WS_SESSION_TTL_SECONDS=1200
AI_WS_MAX_SESSIONS=200
AI_WS_MAX_SESSIONS_PER_DEVICE=4
AI_WS_MAX_TEMP_BYTES=67108864
AI_WS_CLEANUP_INTERVAL_SECONDS=60
AI_WS_SEND_QUEUE_SIZE=32
ASR_PROVIDER=dashscope
ASR_MODEL=qwen3-asr-flash-2026-02-10
ASR_FALLBACK_MODEL=paraformer-realtime-v2
ASR_LANGUAGE=zh
ASR_ENABLE_ITN=false
ASR_TIMEOUT_SECONDS=60
# ASR_API_KEY=REPLACE_WITH_SECRET
ASR_FRAME_BYTES=3200
ASR_FRAME_SLEEP_SECONDS=0
ASR_ARTIFACT_PHONETIC_THRESHOLD=0.86
# ASR_EXTRA_KWARGS={"language_hints":["zh"]}
TTS_PROVIDER=dashscope
TTS_API_STYLE=dashscope_qwen
TTS_MODEL=qwen3-tts-flash-2025-11-27
TTS_VOICE=Cherry
TTS_LANGUAGE_TYPE=Chinese
TTS_RESPONSE_FORMAT=wav
TTS_TIMEOUT_SECONDS=120
# Optional TTS overrides; normally leave empty or commented.
# TTS_API_KEY=REPLACE_WITH_SECRET
TTS_BASE_URL=
DASHSCOPE_TTS_BASE_URL=
TTS_ENDPOINT=
TTS_EXTRA_JSON=
AI_ENABLE_MOCK_TTS=false
AI_MOCK_TTS_SECONDS=0.4
AI_NO_SPEECH_TEXT=我没有听清，请再说一遍。
AI_ASR_ERROR_TEXT=语音识别暂时不可用，请稍后再试。
AI_SILENCE_RMS_THRESHOLD=80
AI_MIN_SPEECH_SECONDS=0.2

# Copy this file to .env. Keep .env untracked and replace secret placeholders.
INTERCOM_IMAGE=ghcr.io/anniconda-li/wkt-intercom-server:0.1.0
AI_IMAGE=ghcr.io/anniconda-li/wkt-ai-server:0.1.0
OTA_IMAGE=ghcr.io/anniconda-li/wkt-ota-server:1.0.0

# Public host ports used directly by first-stage devices.
INTERCOM_HOST_PORT=18081
AI_HOST_PORT=18080
OTA_HOST_PORT=18082

# Persistent host roots. Relative paths are resolved from this repository.
AI_DATA_ROOT=./data/ai
OTA_DATA_ROOT=./data/ota
BACKUP_ROOT=./backups

# OTA runtime. First-stage laboratory validation uses public HTTP without a token.
OTA_PUBLIC_BASE_URL=http://139.129.17.67:18082
OTA_LOG_LEVEL=INFO

# Intercom runtime (confirmed from ../wkt-intercom-server).
INTERCOM_LOG_STATS=1
INTERCOM_LOG_AUDIO_TRACE=0
INTERCOM_AUDIO_LOG_EVERY_N=50
INTERCOM_SEND_QUEUE_MAX=80
INTERCOM_SEND_TIMEOUT_SECONDS=2
INTERCOM_REALTIME_WINDOW_MS=400
INTERCOM_STATS_INTERVAL_MS=1000

# AI runtime (confirmed from ../wkt-ai-server). Never commit real keys.
OPENAI_API_KEY=REPLACE_WITH_SECRET
OPENAI_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com
LOG_LEVEL=INFO
DASHSCOPE_API_KEY=REPLACE_WITH_SECRET
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_PROVIDER=dashscope
VISION_MODEL=qwen-vl-plus
VISION_MIN_CONFIDENCE=0.60
MAX_SAVED_IMAGES_PER_DEVICE=10
ASR_PROVIDER=dashscope
ASR_MODEL=paraformer-realtime-v2
ASR_FRAME_BYTES=3200
ASR_FRAME_SLEEP_SECONDS=0
ASR_ARTIFACT_PHONETIC_THRESHOLD=0.86
TTS_PROVIDER=dashscope
TTS_API_STYLE=dashscope_qwen
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry
TTS_LANGUAGE_TYPE=Chinese
TTS_RESPONSE_FORMAT=wav
TTS_TIMEOUT_SECONDS=120
# Optional legacy DashScope TTS base URL override; normally leave empty.
DASHSCOPE_TTS_BASE_URL=
AI_ENABLE_MOCK_TTS=false
AI_MOCK_TTS_SECONDS=0.4
AI_NO_SPEECH_TEXT=我没有听清，请再说一遍。
AI_ASR_ERROR_TEXT=语音识别暂时不可用，请稍后再试。
AI_SILENCE_RMS_THRESHOLD=80
AI_MIN_SPEECH_SECONDS=0.2
